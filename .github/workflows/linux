name: Build The Watcher (Linux + .deb)

on: [push, workflow_dispatch]

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Librerías del sistema que necesita Qt (para compilar y probar)
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends libgl1 libegl1 libdbus-1-3 libfontconfig1 libglib2.0-0 \
            libxkbcommon0 libxkbcommon-x11-0 libxcb-xinerama0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
            libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xkb1 libxcb-cursor0 libxcb-xfixes0 \
            libxcb-sync1 libxcb-shm0

      - name: Instalar dependencias
        run: python -m pip install -r requirements-linux.txt pyinstaller==6.10.0

      - name: Compilar (carpeta con todo incluido)
        run: |
          pyinstaller --noconfirm --clean --onedir --name TheWatcher \
            --add-data "assets:assets" \
            --collect-all av \
            --exclude-module tkinter \
            --exclude-module PyQt5.QtWebEngineCore --exclude-module PyQt5.QtWebEngineWidgets \
            --exclude-module PyQt5.QtQml --exclude-module PyQt5.QtQuick \
            --exclude-module PyQt5.QtSql --exclude-module PyQt5.QtMultimedia \
            main.py

      - name: Autodiagnóstico del programa compilado
        env:
          QT_QPA_PLATFORM: offscreen
        run: |
          if ! timeout 180 ./dist/TheWatcher/TheWatcher --selftest "$PWD/selftest.txt"; then
            echo "El autodiagnóstico falló"; cat selftest.txt || true; exit 1
          fi
          cat selftest.txt

      - name: Empaquetar .tar.gz
        run: |
          mkdir pkg
          cp -r dist/TheWatcher pkg/TheWatcher
          cp linux/install.sh linux/uninstall.sh linux/LEEME.txt assets/watcher.png pkg/TheWatcher/
          chmod +x pkg/TheWatcher/install.sh pkg/TheWatcher/uninstall.sh pkg/TheWatcher/TheWatcher
          tar -czf TheWatcher-Linux-x86_64.tar.gz -C pkg TheWatcher

      - name: Crear paquete .deb (Debian / Ubuntu / antiX / Mint)
        run: |
          VERSION="1.1.${{ github.run_number }}"
          bash linux/make_deb.sh "$VERSION" dist/TheWatcher "thewatcher_${VERSION}_amd64.deb"
          dpkg-deb -I "thewatcher_${VERSION}_amd64.deb"

      - name: Resumen de lo generado
        run: |
          ls -lh thewatcher_*_amd64.deb TheWatcher-Linux-x86_64.tar.gz
          { echo "### Archivos generados"; echo '```'; ls -lh thewatcher_*_amd64.deb TheWatcher-Linux-x86_64.tar.gz; echo '```'; } >> "$GITHUB_STEP_SUMMARY"

      - name: Subir el .deb
        uses: actions/upload-artifact@v4
        with:
          name: TheWatcher-Linux-deb
          path: thewatcher_*_amd64.deb
          if-no-files-found: error

      - name: Subir el .tar.gz
        uses: actions/upload-artifact@v4
        with:
          name: TheWatcher-Linux-tar
          path: TheWatcher-Linux-x86_64.tar.gz
          if-no-files-found: error

  # Instala el .deb en un Debian 12 limpio (la base de antiX 23) y comprueba que abre.
  verify-deb:
    needs: build
    runs-on: ubuntu-22.04
    container: debian:12
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: TheWatcher-Linux-deb
          path: pkg

      - name: Instalar el .deb con apt (resuelve las dependencias solo)
        run: |
          apt-get update
          apt-get install -y --no-install-recommends fonts-dejavu-core
          apt-get install -y ./pkg/thewatcher_*_amd64.deb
          dpkg -L thewatcher | grep -E "bin/|\.desktop"

      - name: Comprobar que no falta ninguna librería de Qt
        run: |
          QXCB="$(find /opt/thewatcher -name libqxcb.so | head -n 1)"
          test -n "$QXCB"
          MISSING="$(LD_LIBRARY_PATH="$(dirname "$QXCB")/../../lib:/opt/thewatcher/_internal" ldd "$QXCB" | grep 'not found' || true)"
          if [ -n "$MISSING" ]; then
            echo "El .deb no declara estas dependencias:"; echo "$MISSING"; exit 1
          fi

      - name: Autodiagnóstico desde el paquete instalado
        env:
          QT_QPA_PLATFORM: offscreen
        run: |
          if ! thewatcher --selftest /tmp/selftest.txt; then
            echo "El autodiagnóstico falló"; cat /tmp/selftest.txt || true; exit 1
          fi
          cat /tmp/selftest.txt

      - name: Desinstalar sin dejar restos
        run: |
          apt-get remove -y thewatcher
          test ! -e /opt/thewatcher
          test ! -e /usr/bin/thewatcher

  release:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: [build, verify-deb]
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/download-artifact@v4
        with:
          pattern: TheWatcher-Linux-*
          merge-multiple: true
          path: out

      - name: Publicar en el Release
        uses: softprops/action-gh-release@v2
        with:
          files: |
            out/TheWatcher-Linux-x86_64.tar.gz
            out/thewatcher_*_amd64.deb
